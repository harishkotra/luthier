# ---- secrets / local config -------------------------------------------------
# .env holds the real API key; .env.example is the committed template.
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ---- python (agent/ server) -------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.log

# ---- node / vite (client/) --------------------------------------------------
node_modules/
client/node_modules/
client/dist/
client/dist-ssr/
.sass-cache/
.vite/
client/*.timestamp-*.mjs
*.tsbuildinfo
client/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel/

# ---- luthier runtime output -------------------------------------------------
# One JSON file per audit run + the JSONL tool-call log. Regenerated on demand.
runs/*
!runs/.gitkeep
audit.log
.luthier_uploads/
.luthier_sources/
.luthier-fixtures/
tmp/
*.zip

# ---- editors / OS -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

docs/launch-notes.md
docs/blog-harness-drift.md
